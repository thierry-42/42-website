# Required on each deployment: development, staging, or production.
# The staging service uses staging. The production service uses production.
SITE_ENVIRONMENT=staging

# Enable the approved visual-preferences controls in the selected environment.
NEXT_PUBLIC_VISUAL_PREFERENCES_ENABLED=true

# Optional public company profile. Leave empty until approved.
NEXT_PUBLIC_LINKEDIN_URL=

# Approved staging/testing HubSpot form. These identifiers are public embed
# configuration, not credentials. Provide all three values together.
HUBSPOT_STAGING_REGION=eu1
HUBSPOT_STAGING_PORTAL_ID=148811132
HUBSPOT_STAGING_FORM_ID=da5e2637-3fc8-4ab0-96b1-4764ecd0f16e

# Configure the approved production form only on the production service.
# Production never falls back to the staging form.
HUBSPOT_PRODUCTION_REGION=
HUBSPOT_PRODUCTION_PORTAL_ID=
HUBSPOT_PRODUCTION_FORM_ID=

# Server-only PostgreSQL configuration. On Render, use the private/internal
# connection URL for the database attached to this environment. Never expose
# either URL through a NEXT_PUBLIC_ variable.
DATABASE_URL=

# Optional elevated connection used only by `npm run db:migrate`. Leave empty
# when the application database role is also the migration owner.
DATABASE_MIGRATION_URL=

# Keep the total across all Web Service instances below the database plan's
# connection limit.
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Optional local development and automated-test database. Never set this on a
# staging or production service. The only accepted non-empty value is `pg-mem`.
DATABASE_TEST_MODE=
